rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Health check document
    match /test/connection {
      allow read: if true;
    }

    // Conversion Entity Validation
    function isValidConversion(data) {
      return data.keys().hasAll(['userId', 'fileName', 'content', 'status', 'createdAt', 'updatedAt']) 
          && data.userId is string && data.userId.size() <= 128
          && data.fileName is string && data.fileName.size() <= 255
          && data.content is string && data.content.size() <= 1048576
          && data.status in ['draft', 'completed']
          && data.createdAt == request.time
          && data.updatedAt == request.time;
    }

    match /conversions/{conversionId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
                    && isOwner(incoming().userId)
                    && isValidConversion(incoming());
      
      allow update: if isOwner(existing().userId)
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && (
                      // Action: Content update (Auto-save)
                      incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']) ||
                      // Action: Full update (Manual Save)
                      incoming().diff(existing()).affectedKeys().hasOnly(['content', 'status', 'updatedAt', 'fileName'])
                    );
                    
      allow delete: if isOwner(existing().userId);
    }

    match /userPreferences/{userId} {
      allow get: if isOwner(userId);
      allow write: if isOwner(userId) 
                    && incoming().keys().hasAll(['maxRecentProjects'])
                    && incoming().maxRecentProjects is number;
    }

    match /userProfiles/{userId} {
      allow get: if isSignedIn(); // Allow others to see profiles if needed, or isOwner(userId) for private
      allow create: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().displayName is string
                    && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().updatedAt == request.time
                    && incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'photoURL', 'bio', 'updatedAt']);
    }
  }
}
